PORT=4000

# Public tunnel URL (e.g. https://gauntlet.example.trycloudflare.com). Used to build the
# start_url returned by POST /api/runs/start. Defaults to the origin of the request.
PUBLIC_URL=

# Where runs are written (runs/<run_id>.json). Defaults to <repo>/data.
DATA_DIR=

# Built gauntlet to serve. Defaults to <repo>/apps/gauntlet/dist.
GAUNTLET_DIST=
