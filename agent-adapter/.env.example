# Copy to agent-adapter/.env — both runners and the classifier are Claude-backed (PRD §12).
# Use a dedicated key for the demo, not a personal one already under load.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Defaults match the dev servers; override if the demo runs on another machine.
GAUNTLET_SERVER=http://localhost:4000
GAUNTLET_URL=http://localhost:5173
