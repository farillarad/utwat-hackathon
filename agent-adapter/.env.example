# Copy to agent-adapter/.env. Never commit the real file.

# Both agents run on the SAME pinned model (PRD v2 §9) — record it on every run.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Steel cloud browsers (PRD v2 §7). Sponsor credits — ask the team for the key.
STEEL_API_KEY=ste-...

# Where Steel's browsers load the gauntlet. Leave unset to use the URL that
# `python tunnel.py` writes to agent-adapter/.public_url; set it for a named tunnel.
# PUBLIC_URL=https://your-tunnel.trycloudflare.com
